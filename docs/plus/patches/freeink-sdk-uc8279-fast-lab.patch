+// CrossPoint Plus lab hooks for fast (DU) refreshes; 0 keeps the stock behavior.
+// uc8279FastPllOverride: PLL (0x30) written after PON. uc8279FastLutFrames: when
+// set, an external single-phase B/W LUT of that many frames replaces the OTP DU.
+volatile uint8_t uc8279FastPllOverride = 0;
+volatile uint8_t uc8279FastLutFrames = 0;
+
+namespace {
+void writeFastBwLuts(EpdBus& bus, uint8_t frames) {
+  const uint8_t f = static_cast<uint8_t>(frames & 0x3F);
+  // Per table: group = {0x01, phase0..3 = (rail << 6) | frames, 0x01, 0x01}; rail 1 = to black, 2 = to white.
+  const uint8_t rails[5] = {0, 0, 2, 1, 0};  // VCOM, WW, BW (to white), WB (to black), BB
+  for (uint8_t t = 0; t < 5; t++) {
+    uint8_t data[GRAY_LUT_LEN] = {};
+    data[0] = 0x01;
+    data[1] = static_cast<uint8_t>((rails[t] << 6) | f);
+    data[5] = 0x01;
+    data[6] = 0x01;
+    bus.cmd(static_cast<uint8_t>(0x20 + t));
+    bus.data(data, GRAY_LUT_LEN);
+  }
+}
+}  // namespace
