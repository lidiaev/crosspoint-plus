+void Uc8279X4Driver::setPartialWindow(EpdBus& bus, const DirtyWindow& w) {
+  const uint16_t xs = static_cast<uint16_t>(w.x0 * 8);
+  const uint16_t xe = static_cast<uint16_t>(w.x1 * 8 + 7);
+  const uint16_t ys = static_cast<uint16_t>(_cfg.gateOffset + w.y0);
+  const uint16_t ye = static_cast<uint16_t>(_cfg.gateOffset + w.y1);
+  bus.cmd(CMD_PARTIAL_WINDOW);
+  bus.data(static_cast<uint8_t>(xs >> 8));
+  bus.data(static_cast<uint8_t>(xs & 0xF8));
+  bus.data(static_cast<uint8_t>(xe >> 8));
+  bus.data(static_cast<uint8_t>(xe | 0x07));
+  bus.data(static_cast<uint8_t>(ys >> 8));
+  bus.data(static_cast<uint8_t>(ys & 0xFF));
+  bus.data(static_cast<uint8_t>(ye >> 8));
+  bus.data(static_cast<uint8_t>(ye & 0xFF));
+  bus.data(0x01);
+}
+
+void Uc8279X4Driver::writeWindows(EpdBus& bus, uint8_t ramCmd, const uint8_t* fb) {
+  for (uint8_t i = 0; i < _windowCount; i++) {
+    const DirtyWindow& w = _windows[i];
+    setPartialWindow(bus, w);
+    bus.cmd(ramCmd);
+    bus.beginTxn();
+    const uint16_t len = static_cast<uint16_t>(w.x1 - w.x0 + 1);
+    for (uint16_t y = w.y0; y <= w.y1; y++) bus.rawWriteBytes(fb + static_cast<uint32_t>(y) * _wb + w.x0, len);
+    bus.endTxn();
+  }
+}
