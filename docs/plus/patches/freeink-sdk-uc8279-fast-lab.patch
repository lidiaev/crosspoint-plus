+namespace {
+void writeFastBwLuts(EpdBus& bus, uint8_t frames, uint8_t whiteFrames) {
+  // Tables of one bank must finish together: the shorter rail is padded with an idle (VSS) phase.
+  const uint8_t black = static_cast<uint8_t>(frames & 0x3F);
+  const uint8_t white = static_cast<uint8_t>((whiteFrames ? whiteFrames : frames) & 0x3F);
+  const uint8_t total = black > white ? black : white;
+  // Per table: group = {0x01, phase0..3 = (rail << 6) | frames, 0x01, 0x01}; rail 1 = to black, 2 = to white.
+  const uint8_t rails[5] = {0, 0, 2, 1, 0};  // VCOM, WW, BW (to white), WB (to black), BB
+  for (uint8_t t = 0; t < 5; t++) {
+    uint8_t data[GRAY_LUT_LEN] = {};
+    data[0] = 0x01;
+    const uint8_t active = rails[t] == 2 ? white : rails[t] == 1 ? black : total;
+    data[1] = static_cast<uint8_t>((rails[t] << 6) | active);
+    data[2] = static_cast<uint8_t>(total - active);  // idle padding
+    data[5] = 0x01;
+    data[6] = 0x01;
+    bus.cmd(static_cast<uint8_t>(0x20 + t));
+    bus.data(data, GRAY_LUT_LEN);
+  }
+}
