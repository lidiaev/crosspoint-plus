+uint8_t Uc8279X4Driver::findDirtyWindows(const uint8_t* fb) {
+  // Changed rows per byte column; runs of changed columns become windows.
+  uint16_t minY[128];
+  uint16_t maxY[128];
+  const uint16_t wb = _wb <= 128 ? _wb : 128;
+  for (uint16_t x = 0; x < wb; x++) {
+    minY[x] = UINT16_MAX;
+    maxY[x] = 0;
+  }
+  for (uint16_t y = 0; y < _h; y++) {
+    const uint8_t* a = fb + static_cast<uint32_t>(y) * _wb;
+    const uint8_t* b = _shadow + static_cast<uint32_t>(y) * _wb;
+    if (memcmp(a, b, wb) == 0) continue;
+    for (uint16_t x = 0; x < wb; x++) {
+      if (a[x] == b[x]) continue;
+      if (y < minY[x]) minY[x] = y;
+      maxY[x] = y;
+    }
+  }
+  constexpr uint16_t MERGE_GAP = 2;  // byte columns
+  uint8_t count = 0;
+  for (uint16_t x = 0; x < wb; x++) {
+    if (minY[x] == UINT16_MAX) continue;
+    if (count > 0 && x - _windows[count - 1].x1 <= MERGE_GAP + 1) {
+      DirtyWindow& w = _windows[count - 1];
+      w.x1 = x;
+      if (minY[x] < w.y0) w.y0 = minY[x];
+      if (maxY[x] > w.y1) w.y1 = maxY[x];
+      continue;
+    }
+    if (count == MAX_WINDOWS) {
+      // Out of slots: grow the last window to cover this column too.
+      DirtyWindow& w = _windows[count - 1];
+      w.x1 = x;
+      if (minY[x] < w.y0) w.y0 = minY[x];
+      if (maxY[x] > w.y1) w.y1 = maxY[x];
+      continue;
+    }
+    _windows[count++] = DirtyWindow{x, x, minY[x], maxY[x]};
+  }
+  return count;
+}
